# Hatena Blog Configuration
# Copy this file to .env and fill in your actual values

# Your Hatena ID
HATENA_ID=your_hatena_id

# API Key from your Hatena account settings
# Get from: https://blog.hatena.ne.jp/my/config/account
HATENA_API_KEY=your_api_key

# Your blog ID (usually your blog domain without .hatenablog.com)
# Example: if your blog is myblog.hatenablog.com, use "myblog"
HATENA_BLOG_ID=your_blog_id

